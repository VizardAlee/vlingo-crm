rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(orgId) {
      return firestore.get(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data;
    }

    function hasMemberDoc(orgId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function isActiveMember(orgId) {
      return hasMemberDoc(orgId) && memberDoc(orgId).status == "active";
    }

    function hasAnyPermission(orgId, permissions) {
      return isActiveMember(orgId) &&
        (memberDoc(orgId).role == "superAdmin" ||
        memberDoc(orgId).permissions.hasAny(permissions));
    }

    function canManageBranding(orgId) {
      return hasAnyPermission(orgId, ["users.manage", "roles.manage"]);
    }

    function canUseDocuments(orgId) {
      return hasAnyPermission(orgId, [
        "leads.readAssigned",
        "leads.readAll",
        "clients.read",
        "deals.read",
        "properties.read",
        "units.read",
        "rentals.read",
        "development.read",
        "marketing.read",
        "offerings.read",
        "tasks.read",
        "activities.read",
        "reports.viewFinancial",
        "auditLogs.read"
      ]);
    }

    match /organizations/{orgId}/branding/{fileName} {
      allow read: if isActiveMember(orgId);
      allow write: if canManageBranding(orgId) &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches("image/.*");
    }

    match /organizations/{orgId}/{folder}/{allPaths=**} {
      allow read: if canUseDocuments(orgId);
      allow write: if folder != "branding" && canUseDocuments(orgId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
