rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }

    function isActiveMember(orgId) {
      return signedIn() &&
        exists(memberPath(orgId)) &&
        get(memberPath(orgId)).data.status == "active";
    }

    function memberData(orgId) {
      return get(memberPath(orgId)).data;
    }

    function permissions(orgId) {
      return memberData(orgId).keys().hasAny(["permissions"]) &&
        memberData(orgId).permissions is list
        ? memberData(orgId).permissions
        : [];
    }

    function hasRole(orgId, allowed) {
      return isActiveMember(orgId) &&
        (allowed.hasAny([memberData(orgId).role]) ||
        (memberData(orgId).keys().hasAny(["roles"]) &&
        memberData(orgId).roles is list &&
        memberData(orgId).roles.hasAny(allowed)));
    }

    function hasPermission(orgId, permission) {
      return isActiveMember(orgId) &&
        (hasRole(orgId, ["superAdmin"]) || permissions(orgId).hasAny([permission]));
    }

    function hasAnyPermission(orgId, allowed) {
      return isActiveMember(orgId) &&
        (hasRole(orgId, ["superAdmin"]) || permissions(orgId).hasAny(allowed));
    }

    function canAccessAnyBranch(orgId) {
      return hasRole(orgId, ["superAdmin"]) || memberData(orgId).branchAccess == "all";
    }

    function canAccessBranch(orgId, branchId) {
      return isActiveMember(orgId) &&
        (canAccessAnyBranch(orgId) ||
        (branchId is string && memberData(orgId).branchId == branchId));
    }

    function canReadRecordBranch(orgId) {
      return canAccessBranch(orgId, resource.data.branchId);
    }

    function canWriteRequestBranch(orgId) {
      return canAccessBranch(orgId, request.resource.data.branchId);
    }

    function isBrandPartner(orgId) {
      return hasRole(orgId, ["brandPartner"]);
    }

    function partnerBrandIds(orgId) {
      return memberData(orgId).keys().hasAny(["partnerBrandIds"]) &&
        memberData(orgId).partnerBrandIds is list
        ? memberData(orgId).partnerBrandIds
        : [];
    }

    function partnerBranchIds(orgId) {
      return memberData(orgId).keys().hasAny(["partnerBranchIds"]) &&
        memberData(orgId).partnerBranchIds is list
        ? memberData(orgId).partnerBranchIds
        : [memberData(orgId).branchId];
    }

    function canAccessPartnerBranch(orgId, branchId) {
      return !isBrandPartner(orgId) ||
        (branchId is string && partnerBranchIds(orgId).hasAny([branchId]));
    }

    function canAccessInventoryBrand(orgId, brandId) {
      return hasPermission(orgId, "inventory.read") &&
        (!isBrandPartner(orgId) || (brandId is string && partnerBrandIds(orgId).hasAny([brandId])));
    }

    function canReadInventoryRecord(orgId) {
      return canAccessInventoryBrand(orgId, resource.data.brandId) &&
        ((isBrandPartner(orgId) && canAccessPartnerBranch(orgId, resource.data.branchId)) ||
        (!isBrandPartner(orgId) && canReadRecordBranch(orgId)));
    }

    function assignedOnlySalesUser(orgId) {
      return hasRole(orgId, ["salesExecutive"]) &&
        !hasRole(orgId, ["superAdmin", "managingDirector", "operationsManager", "salesManager"]);
    }

    function assignedOnlyClientAccess(orgId) {
      return !assignedOnlySalesUser(orgId) ||
        resource.data.assignedRelationshipManager == request.auth.uid ||
        resource.data.assignedTo == request.auth.uid;
    }

    function assignedOnlyDealAccess(orgId) {
      return !assignedOnlySalesUser(orgId) ||
        resource.data.dealOwnerId == request.auth.uid ||
        resource.data.assignedTo == request.auth.uid;
    }

    function assignedOnlyTaskAccess(orgId) {
      return !assignedOnlySalesUser(orgId) ||
        resource.data.assignedTo == request.auth.uid;
    }

    function canReadDeals(orgId) {
      return hasAnyPermission(orgId, ["deals.read", "reports.viewFinancial"]);
    }

    function validInventoryOfferingBrand(orgId) {
      return !["material", "solarEquipment"].hasAny([request.resource.data.type]) ||
        (request.resource.data.brandId is string &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/inventoryBrands/$(request.resource.data.brandId)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/inventoryBrands/$(request.resource.data.brandId)).data.status == "active");
    }

    function canCreateDeals(orgId) {
      return hasPermission(orgId, "deals.create");
    }

    function canUpdateDeals(orgId) {
      return hasPermission(orgId, "deals.update");
    }

    function canUpdateDealFinanceSummary(orgId) {
      return organizationUnchanged(orgId) &&
        canReadRecordBranch(orgId) &&
        hasAnyPermission(orgId, ["finance.update", "finance.approve"]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "organizationId",
          "updatedAt",
          "updatedBy",
          "balanceAmount",
          "financeStatus",
          "lastPaymentAmount",
          "lastPaymentAt",
          "lastReceiptNumber",
          "paidAmount",
          "pendingPaymentAmount"
        ]);
    }

    function canUseDeals(orgId) {
      return canReadDeals(orgId) || canCreateDeals(orgId) || canUpdateDeals(orgId);
    }

    function canUseDocuments(orgId) {
      return hasAnyPermission(orgId, [
        "leads.readAssigned",
        "leads.readAll",
        "clients.read",
        "deals.read",
        "properties.read",
        "units.read",
        "rentals.read",
        "development.read",
        "marketing.read",
        "offerings.read",
        "tasks.read",
        "activities.read",
        "reports.viewFinancial",
        "auditLogs.read"
      ]);
    }

    function organizationMatches(orgId) {
      return request.resource.data.organizationId == orgId;
    }

    function organizationUnchanged(orgId) {
      return resource.data.organizationId == request.resource.data.organizationId &&
        request.resource.data.organizationId == orgId;
    }

    function hasMetadata(orgId) {
      return organizationMatches(orgId) &&
        request.resource.data.branchId is string &&
        canWriteRequestBranch(orgId) &&
        request.resource.data.createdBy is string &&
        request.resource.data.updatedBy is string &&
        request.resource.data.isDeleted is bool;
    }

    function changesFinanceApprovalState() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "approvalStatus",
        "approvedAt",
        "approvedBy",
        "paidAt",
        "paidBy",
        "rejectedAt",
        "rejectedBy",
        "rejectionReason",
        "verificationStatus",
        "verifiedAt",
        "verifiedBy"
      ]);
    }

    function canUpdateFinanceRecord(orgId) {
      return organizationUnchanged(orgId) &&
        canReadRecordBranch(orgId) &&
        (hasPermission(orgId, "finance.approve") ||
        (hasPermission(orgId, "finance.update") && !changesFinanceApprovalState()));
    }

    function canUpdateOwnNotification(orgId) {
      return organizationUnchanged(orgId) &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.recipientId == resource.data.recipientId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "organizationId",
          "readAt",
          "readBy",
          "updatedAt",
          "updatedBy"
        ]);
    }

    function validOwnPushSubscription(orgId) {
      return organizationMatches(orgId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.branchId is string &&
        canWriteRequestBranch(orgId) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() > 20 &&
        request.resource.data.status == "active" &&
        request.resource.data.isDeleted == false;
    }

    function canUpdateOwnPushSubscription(orgId) {
      return organizationUnchanged(orgId) &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        validOwnPushSubscription(orgId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "branchId",
          "createdAt",
          "createdBy",
          "isDeleted",
          "organizationId",
          "status",
          "token",
          "updatedAt",
          "updatedBy",
          "userAgent",
          "userId"
        ]);
    }

    function canSoftDeleteLead(orgId) {
      return organizationUnchanged(orgId) &&
        hasRole(orgId, ["superAdmin"]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "deletedAt",
          "deletedBy",
          "isDeleted",
          "updatedAt",
          "updatedBy"
        ]) &&
        request.resource.data.isDeleted == true &&
        resource.data.isDeleted == false &&
        request.resource.data.deletedBy == request.auth.uid &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    match /organizations/{orgId} {
      allow read: if isActiveMember(orgId);
      allow create, update, delete: if hasPermission(orgId, "users.manage");

      match /members/{memberId} {
        allow read: if isActiveMember(orgId) &&
          (memberId == request.auth.uid || hasAnyPermission(orgId, ["users.manage", "roles.manage", "tasks.create", "tasks.update", "activities.read"]));
        allow create, update, delete: if false;
      }

      match /internalAiGuideUsage/{userId}/days/{dayId} {
        allow get: if isActiveMember(orgId) && userId == request.auth.uid;
        allow list: if false;
        allow create: if isActiveMember(orgId) &&
          userId == request.auth.uid &&
          dayId == request.resource.data.day &&
          request.resource.data.organizationId == orgId &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.day is string &&
          request.resource.data.count == 1;
        allow update: if isActiveMember(orgId) &&
          userId == request.auth.uid &&
          dayId == resource.data.day &&
          dayId == request.resource.data.day &&
          resource.data.organizationId == orgId &&
          resource.data.userId == request.auth.uid &&
          resource.data.day is string &&
          request.resource.data.organizationId == orgId &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.day == resource.data.day &&
          request.resource.data.count == resource.data.count + 1;
        allow delete: if false;
      }

      match /roles/{roleId} {
        allow read: if isActiveMember(orgId);
        allow write: if hasPermission(orgId, "roles.manage");
      }

      match /branches/{branchId} {
        allow read: if isActiveMember(orgId);
        allow write: if hasPermission(orgId, "users.manage") && request.resource.data.organizationId == orgId;
      }

      match /leads/{leadId} {
        allow read: if canReadRecordBranch(orgId) && (hasPermission(orgId, "reports.viewFinancial") ||
          hasPermission(orgId, "leads.readAll") ||
          (hasPermission(orgId, "leads.readAssigned") && resource.data.assignedTo == request.auth.uid));
        allow create: if hasPermission(orgId, "leads.create") && hasMetadata(orgId);
        allow update: if canSoftDeleteLead(orgId) ||
          (organizationUnchanged(orgId) &&
          canReadRecordBranch(orgId) &&
          request.resource.data.isDeleted == resource.data.isDeleted &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["deletedAt", "deletedBy"]) &&
          (hasPermission(orgId, "leads.assign") ||
          (hasPermission(orgId, "leads.updateAssigned") && resource.data.assignedTo == request.auth.uid)));
        allow delete: if false;
      }

      match /clients/{clientId} {
        allow read: if canReadRecordBranch(orgId) &&
          assignedOnlyClientAccess(orgId) &&
          (canUseDeals(orgId) || hasAnyPermission(orgId, ["clients.read", "rentals.create", "rentals.read", "rentals.update"]));
        allow create: if hasPermission(orgId, "clients.create") && hasMetadata(orgId);
        allow update: if hasPermission(orgId, "clients.update") &&
          organizationUnchanged(orgId) &&
          canReadRecordBranch(orgId) &&
          assignedOnlyClientAccess(orgId);
        allow delete: if false;
      }

      match /deals/{dealId} {
        allow read: if canReadRecordBranch(orgId) && assignedOnlyDealAccess(orgId) && canReadDeals(orgId);
        allow create: if canCreateDeals(orgId) && hasMetadata(orgId);
        allow update: if (canUpdateDeals(orgId) &&
          organizationUnchanged(orgId) &&
          canReadRecordBranch(orgId) &&
          assignedOnlyDealAccess(orgId)) ||
          canUpdateDealFinanceSummary(orgId);
        allow delete: if false;
      }

      match /properties/{propertyId} {
        allow read: if canReadRecordBranch(orgId) && (canUseDeals(orgId) || hasAnyPermission(orgId, ["properties.read", "rentals.create", "rentals.read", "rentals.update"]));
        allow create: if hasPermission(orgId, "properties.create") && hasMetadata(orgId);
        allow update: if hasPermission(orgId, "properties.update") && organizationUnchanged(orgId) && canReadRecordBranch(orgId);
        allow delete: if false;
      }

      match /propertyStakeholders/{stakeholderId} {
        allow read: if canReadRecordBranch(orgId) && hasAnyPermission(orgId, ["properties.read", "rentals.create", "rentals.read", "rentals.update"]);
        allow create: if hasPermission(orgId, "properties.create") && hasMetadata(orgId);
        allow update: if hasPermission(orgId, "properties.update") && organizationUnchanged(orgId) && canReadRecordBranch(orgId);
        allow delete: if false;
      }

      match /propertyUnits/{unitId} {
        allow read: if canReadRecordBranch(orgId) && (canUseDeals(orgId) || hasAnyPermission(orgId, ["units.read", "rentals.create", "rentals.read", "rentals.update"]));
        allow create: if hasPermission(orgId, "units.create") && hasMetadata(orgId);
        allow update: if hasPermission(orgId, "units.update") && organizationUnchanged(orgId) && canReadRecordBranch(orgId);
        allow delete: if false;
      }

      match /offerings/{offeringId} {
        allow read: if (canReadRecordBranch(orgId) && hasPermission(orgId, "offerings.read")) || canReadInventoryRecord(orgId);
        allow create: if hasPermission(orgId, "offerings.create") && hasMetadata(orgId) && validInventoryOfferingBrand(orgId);
        allow update: if hasPermission(orgId, "offerings.update") && organizationUnchanged(orgId) && canReadRecordBranch(orgId) && validInventoryOfferingBrand(orgId);
        allow delete: if false;
      }

      match /inventoryBrands/{brandId} {
        allow read: if canAccessInventoryBrand(orgId, resource.data.brandId);
        allow create: if hasPermission(orgId, "inventory.manageCatalog") && hasMetadata(orgId);
        allow update: if hasPermission(orgId, "inventory.manageCatalog") && organizationUnchanged(orgId) && canReadRecordBranch(orgId);
        allow delete: if false;
      }

      match /inventoryLocations/{locationId} {
        allow read: if !isBrandPartner(orgId) && hasPermission(orgId, "inventory.read") && canReadRecordBranch(orgId);
        allow create: if hasPermission(orgId, "inventory.manageCatalog") && hasMetadata(orgId);
        allow update: if hasPermission(orgId, "inventory.manageCatalog") && organizationUnchanged(orgId) && canReadRecordBranch(orgId);
        allow delete: if false;
      }

      match /inventoryBalances/{balanceId} {
        allow read: if canReadInventoryRecord(orgId);
        allow write: if false;
      }

      match /inventoryMovements/{movementId} {
        allow read: if canReadInventoryRecord(orgId);
        allow write: if false;
      }

      match /inventoryLots/{lotId} {
        allow read: if canReadInventoryRecord(orgId);
        allow write: if false;
      }

      match /inventorySerials/{serialId} {
        allow read: if canReadInventoryRecord(orgId);
        allow write: if false;
      }

      match /inventorySuppliers/{supplierId} {
        allow read: if !isBrandPartner(orgId) && hasPermission(orgId, "inventory.read") && canReadRecordBranch(orgId);
        allow create: if hasAnyPermission(orgId, ["inventory.manageCatalog", "inventory.procure"]) && hasMetadata(orgId);
        allow update: if hasAnyPermission(orgId, ["inventory.manageCatalog", "inventory.procure"]) && organizationUnchanged(orgId) && canReadRecordBranch(orgId);
        allow delete: if false;
      }

      match /inventoryPurchaseOrders/{purchaseOrderId} {
        allow read: if !isBrandPartner(orgId) && hasPermission(orgId, "inventory.read") && canReadRecordBranch(orgId);
        allow write: if false;
      }

      match /inventoryStockCounts/{countId} {
        allow read: if !isBrandPartner(orgId) && hasPermission(orgId, "inventory.read") && canReadRecordBranch(orgId);
        allow write: if false;
      }

      match /inventoryReservations/{reservationId} {
        allow read: if !isBrandPartner(orgId) && hasPermission(orgId, "inventory.read") && canReadRecordBranch(orgId);
        allow write: if false;
      }

      match /inventoryComments/{commentId} {
        allow read: if canReadInventoryRecord(orgId);
        allow create: if hasPermission(orgId, "inventory.comment") &&
          organizationMatches(orgId) &&
          canAccessInventoryBrand(orgId, request.resource.data.brandId) &&
          request.resource.data.branchId is string &&
          ((isBrandPartner(orgId) && canAccessPartnerBranch(orgId, request.resource.data.branchId)) ||
          (!isBrandPartner(orgId) && canWriteRequestBranch(orgId))) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.isDeleted == false;
        allow update, delete: if false;
      }

      match /rentalTenancies/{tenancyId} {
        allow read: if canReadRecordBranch(orgId) && hasPermission(orgId, "rentals.read");
        allow create: if hasPermission(orgId, "rentals.create") && hasMetadata(orgId);
        allow update: if hasPermission(orgId, "rentals.update") && organizationUnchanged(orgId) && canReadRecordBranch(orgId);
        allow delete: if false;
      }

      match /developmentProjects/{projectId} {
        allow read: if canReadRecordBranch(orgId) && hasPermission(orgId, "development.read");
        allow create: if hasPermission(orgId, "development.create") && hasMetadata(orgId);
        allow update: if hasPermission(orgId, "development.update") && organizationUnchanged(orgId) && canReadRecordBranch(orgId);
        allow delete: if false;
      }

      match /marketingCampaigns/{campaignId} {
        allow read: if canReadRecordBranch(orgId) && hasPermission(orgId, "marketing.read");
        allow create: if hasPermission(orgId, "marketing.create") && hasMetadata(orgId);
        allow update: if hasPermission(orgId, "marketing.update") && organizationUnchanged(orgId) && canReadRecordBranch(orgId);
        allow delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isActiveMember(orgId) && resource.data.recipientId == request.auth.uid;
        allow create: if isActiveMember(orgId) &&
          hasMetadata(orgId) &&
          request.resource.data.recipientId == request.auth.uid;
        allow update: if canUpdateOwnNotification(orgId);
        allow delete: if false;
      }

      match /pushSubscriptions/{subscriptionId} {
        allow read: if isActiveMember(orgId) && resource.data.userId == request.auth.uid;
        allow create: if isActiveMember(orgId) && validOwnPushSubscription(orgId);
        allow update: if isActiveMember(orgId) && canUpdateOwnPushSubscription(orgId);
        allow delete: if isActiveMember(orgId) && resource.data.userId == request.auth.uid;
      }

      match /mailSettings/{userId} {
        allow read, write: if false;
      }

      match /calendarConnections/{userId} {
        allow read, write: if false;
      }

      match /tasks/{taskId} {
        allow read: if canReadRecordBranch(orgId) &&
          hasPermission(orgId, "tasks.read") &&
          (resource.data.assignedTo == request.auth.uid || hasAnyPermission(orgId, ["dashboard.viewExecutive", "users.manage"]));
        allow create: if hasPermission(orgId, "tasks.create") && hasMetadata(orgId);
        allow update: if hasPermission(orgId, "tasks.update") &&
          organizationUnchanged(orgId) &&
          canReadRecordBranch(orgId) &&
          assignedOnlyTaskAccess(orgId);
        allow delete: if false;
      }

      match /activities/{activityId} {
        allow read: if canReadRecordBranch(orgId) && hasPermission(orgId, "activities.read");
        allow create: if hasPermission(orgId, "activities.create") && hasMetadata(orgId);
        allow update, delete: if false;
      }

      match /documents/{documentId} {
        allow read: if canReadRecordBranch(orgId) && canUseDocuments(orgId);
        allow create: if canUseDocuments(orgId) && hasMetadata(orgId);
        allow update, delete: if hasPermission(orgId, "users.manage") && canReadRecordBranch(orgId);
      }

      match /financePayments/{paymentId} {
        allow read: if canReadRecordBranch(orgId) && hasPermission(orgId, "reports.viewFinancial");
        allow create: if hasPermission(orgId, "finance.create") && hasMetadata(orgId);
        allow update: if canUpdateFinanceRecord(orgId);
        allow delete: if false;
      }

      match /financeExpenses/{expenseId} {
        allow read: if canReadRecordBranch(orgId) && hasPermission(orgId, "reports.viewFinancial");
        allow create: if hasPermission(orgId, "finance.create") && hasMetadata(orgId);
        allow update: if canUpdateFinanceRecord(orgId);
        allow delete: if false;
      }

      match /financeCommissions/{commissionId} {
        allow read: if canReadRecordBranch(orgId) && hasPermission(orgId, "reports.viewFinancial");
        allow create: if hasPermission(orgId, "finance.create") && hasMetadata(orgId);
        allow update: if canUpdateFinanceRecord(orgId);
        allow delete: if false;
      }

      match /auditLogs/{auditLogId} {
        allow read: if canReadRecordBranch(orgId) && hasPermission(orgId, "auditLogs.read");
        allow create, update, delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
