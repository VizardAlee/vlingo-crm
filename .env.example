NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Public Web Push certificate key from Firebase Console > Project settings > Cloud Messaging.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_DEFAULT_ORGANIZATION_ID=beacon-corporate-realty
NEXT_PUBLIC_DEFAULT_BRANCH_ID=head-office

# Optional: enables Gemini-backed AI Guide answers. Without this, AI Guide uses the built-in CRM guide.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_GUIDE_DAILY_LIMIT=30
AI_GUIDE_RESPONSE_CHARACTER_LIMIT=3500

# Required for private task calendar subscription links. Use a random value with 32+ characters.
CALENDAR_FEED_SECRET=1d32bc72001cdac79ee2cd934e51718d85d9fa068b782ce381c284257cd8806e
NEXT_PUBLIC_ENABLE_PWA_IN_DEV=false

FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Cloud Functions invite link generation
# Optional: set in the Functions runtime environment so setup links return to your app.
APP_BASE_URL=https://vlingo-crm.svoltnigeria.com

# Cloud Functions email settings encryption
# Required before users can save SMTP passwords.
MAIL_SETTINGS_ENCRYPTION_KEY=
